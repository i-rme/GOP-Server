<!go

type pair struct {
	A int
	B string
}

fmt.Println("htmlentities:", _htmlentities(`<a href="x">Tom & 'Jerry'</a>`))
fmt.Println("html_entity_decode:", _html_entity_decode("&lt;b&gt; &amp;amp; &#39;q&#39; &quot;"))
fmt.Println("nl2br:", _nl2br("a\nb\n"))
_echo("echo:", 1, 2, "three", 4.5, true, "\n")
fmt.Println("base64_encode:", _base64_encode("hello gop"))
fmt.Println("base64_decode:", _base64_decode("aGVsbG8gZ29w"))
fmt.Println("base64_decode_invalid:", _base64_decode("!!!") == "")
u, p := _parseAuthentication("Basic " + _base64_encode("alice:s3cret"))
fmt.Println("parseAuthentication:", u, p)
u, p = _parseAuthentication("Bearer abc")
fmt.Println("parseAuthentication_bearer:", u == "", p == "")
fmt.Println("json_encode_struct:", _json_encode(pair{1, "x"}))
fmt.Println("json_encode_map:", _json_encode(map[string]int{"b": 2, "a": 1}))
fmt.Println("json_encode_slice:", _json_encode([]string{"x", "y"}))
fmt.Println("json_decode:", _json_decode(`{"a":1}`))
fmt.Println("string_to_int:", _string_to_int("42"), _string_to_int("-7"), _string_to_int("x"))
fmt.Println("int_to_string:", _int_to_string(99))
fmt.Println("isset:", _isset(""), _isset("a"), _isset(_GET["missing"]))
fmt.Println("substr:", substr("abcdef", 1, 3), substr("abcdef", -5, 99))
fmt.Println("date_format:", regexp.MustCompile(`^\d{4}-\d{2}-\d{2}$`).MatchString(_date("2006-01-02")))
fmt.Println("time_format:", regexp.MustCompile(`^\d{2}:\d{2}$`).MatchString(_time("15:04")))
fmt.Println("_GET:", _GET)
